            token outputs:surface.connect = </wa320/Materials/dark/PreviewSurface.outputs:surface>
            token outputs:volume (
                displayGroup = "Outputs"
            )
        }

        def Material "steel" (
            instanceable = true
            add references = </Flattened_Prototype_14>
        )
        {
            color3f inputs:diffuseColor = (0.19599414, 0.21404114, 0.233022)
            float inputs:metallic = 0
            float inputs:opacity = 1
            float inputs:roughness = 0.5
            token inputs:wrapMode = "repeat"
            token outputs:displacement (
                displayGroup = "Outputs"
            )
            token outputs:surface (
                displayGroup = "Outputs"
            )
            token outputs:surface.connect = </wa320/Materials/steel/PreviewSurface.outputs:surface>
            token outputs:volume (
                displayGroup = "Outputs"
            )
        }
    }

    def PhysicsRevoluteJoint "zbar_closure"
    {
        uniform token physics:axis = "Y"
        rel physics:body0 = </wa320/Geometry/rear_frame/front_frame/boom/bellcrank/rod>
        rel physics:body1 = </wa320/Geometry/rear_frame/front_frame/boom/bucket>
