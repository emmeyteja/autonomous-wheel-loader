        uniform bool physics:excludeFromArticulation = 1
        point3f physics:localPos0 = (1.59, 0, 0)
        point3f physics:localPos1 = (-0.12, 0, 0.5)
    }

    def Material "RigidContact" (
        apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.7
        float physics:restitution = 0
        float physics:staticFriction = 0.8
    }
